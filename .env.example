# ===== smart-coder 配置模板 =====
# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会提交。

# ── 必填 ──────────────────────────────────────────────
# DeepSeek API —— 每个使用者填【自己】的 key
DEEPSEEK_API_KEY=sk-你的key

# 工作区：agent 要协助的【你自己的代码库】绝对路径
# 不填则默认为 agent 自身所在目录（即本仓库）
# 例：WORKSPACE_ROOT=/Users/you/code/my-project
WORKSPACE_ROOT=

# ── 运行模式（选一套）────────────────────────────────
# 【轻量模式 · 同事默认】无需 Docker、无本地大模型，pip install -r requirements.txt：
RAG_ENABLED=false
EXEC_MODE=host

# 【完整模式 · 开发者自己】需要 Docker + 大依赖，pip install -r requirements-full.txt：
# RAG_ENABLED=true
# EXEC_MODE=docker

# ── 可选：模型分工（与 config.py 默认一致，一般不用改）──
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PLANNER_MODEL=deepseek-v4-pro
# EXECUTOR_MODEL=deepseek-v4-flash

# 备注：
# - 命令行 python main.py 与浏览器 web 版共用这份配置；
# - 换项目 = 改 WORKSPACE_ROOT 后重启服务（web 版）或重跑 main.py（CLI）；
# - 轻量模式下 agent 不做 RAG 预索引，用 list_files / search_code / read_file 工具找代码，
#   每条 shell 命令都会弹审批；完整模式用 RAG + Docker 沙箱，仅危险命令需要审批。
