# ===== smart-coder 配置模板 =====
# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会提交。

# ── 必填 ──────────────────────────────────────────────
# DeepSeek API —— 每个使用者填【自己】的 key
DEEPSEEK_API_KEY=sk-你的key

# ── 工作区（可选）────────────────────────────────────
# 现在支持【任意语言 / 任意项目】，且可以在 Web 界面里随时添加和切换，不用改这里：
#   http://127.0.0.1:8000/ 顶部「＋ 添加工程目录」→ 选目录 → 立刻生效
# 项目清单存在 agent 自己目录的 .agent_cache/projects.json，不往你的代码库里写东西。
#
# WORKSPACE_ROOT 只是【一个项目都还没添加时的默认值】，也是 CLI 的兜底：
#   python main.py "跑一下测试" --project=/绝对路径/你的项目
# 不填则默认为 agent 自身所在目录（即本仓库）。
# WORKSPACE_ROOT=/Users/you/code/my-project

# ── 运行模式（三个旋钮，推荐默认那套）─────────────────
# 【默认 · 推荐】本机执行 + **内核围栏**：命令只能写「当前项目目录 + 系统临时目录」，默认禁网。
# 越界不是靠正则去猜，而是内核直接拒绝（macOS Seatbelt / Linux bubblewrap）；
# 模型需要联网或写到项目外时会用 escalate 参数申请，**那才弹人工审批**。
# 拿不到围栏后端时**拒绝执行**（fail closed），不会偷偷降级成无隔离。
EXEC_MODE=local
RAG_ENABLED=false

# 上面这套对应 requirements.txt（不含 torch/chroma，约几百 MB）。
# 想开 RAG 向量检索（需要 pip install -r requirements-full.txt，约 3~5GB）：
# RAG_ENABLED=true

# 两个正交旋钮（留空即按 EXEC_MODE 推导；local 默认就是下面这组，一般不用写）
# SANDBOX_MODE=workspace-write        # read-only（全盘禁写）| workspace-write | danger-full-access
# APPROVAL_POLICY=on-escalation       # always（逐条问）| on-escalation（越界才问）| never（越界直接拒，无人值守）

# 【无隔离 · 兼容旧行为】命令在本机直接跑，没有任何围栏，靠**每条命令人工审批**兜底。
# 只在装不了 bubblewrap（Linux）或 sandbox-exec 不可用时才选它 —— 这是一条明确知情的降级。
# EXEC_MODE=host

# 【强隔离 · Python 项目】命令在非 root Docker 沙箱内执行，默认断网、限时限内存：
# 注意：沙箱镜像目前只带 Python 运行时（见 Dockerfile.sandbox），
#      跑 node/go/rust 等项目的命令会失败，那种情况请用上面的 local 模式。
# EXEC_MODE=docker

# ── 可选：模型分工（与 config.py 默认一致，一般不用改）──
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PLANNER_MODEL=deepseek-v4-pro
# EXECUTOR_MODEL=deepseek-v4-flash

# ── 可选：RAG 行为 ───────────────────────────────────
# 索引是否自动跟随文件变动重建（默认 true）。超大仓库可关掉，只在切项目时建索引。
# RAG_AUTO_REINDEX=true

# ── 可选：运行轨迹（observability，见 README 第十四章 / trace.py）──
# 任务执行时每一步都会**边跑边打印**并落盘：当前节点、调用的模型、工具名与参数、
# 耗时、token、异常。三个开关各管一件事：
#   TRACE_ENABLED=true         # 落 JSONL：.agent_cache/traces/<时间戳>_<项目id>_<runid>.jsonl
#   TRACE_CONSOLE=true         # 往终端流式打印（Web 服务端进程里也打）
#   TRACE_FULL_CONTENT=false   # true 时连完整 prompt / 完整工具输出一起记（默认只记摘要与预览）
#   TRACE_DIR=/abs/path        # 换轨迹目录（默认 <agent>/.agent_cache/traces）
# CLI 另有：--no-trace（本次不打印不落盘）/ --trace（渲染最近一次轨迹）/ --trace=<文件>

# 备注：
# - 命令行 python main.py 与浏览器 web 版共用这份配置，也共用同一份项目清单；
# - 换项目【不需要】改这里、也不需要重启服务：直接在界面里切；
# - 安全模型（详见 README 第九章）：**内核围栏**兜住"越界"、**任务快照**兜住"工作区内被破坏"，
#   审批只在"要越界/围栏兜不住/没有兜底"时才打扰你 —— 普通命令（ls / pytest / rm -rf 工作区文件）
#   在围栏内直接执行，不再逐条弹窗；
# - 每次任务开始会在 .agent_cache/snapshots/<项目id>/<时间戳>/ 打一个 git 快照，可回滚；
# - agent 自己的状态（checkpoint / 记忆 / 快照 / 向量库）统一放在本目录的 .agent_cache/ 下，
#   按项目隔离，不会污染你被协助的代码库。
